# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=UTC

# CORS (the React app's origin). CORS_ALLOW_ALL_ORIGINS is handy in dev only.
CORS_ALLOW_ALL_ORIGINS=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Free third-party services (no API keys required)
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
PHOTON_BASE_URL=https://photon.komoot.io

# Nominatim requires an identifying User-Agent. Nominatim's public server
# rejects generic/bot-looking UAs, so keep a descriptive app + contact URL.
HTTP_USER_AGENT=ELDTripPlanner/1.0 (+https://github.com/AnkitPadhiyar/Minor-Project)
HTTP_TIMEOUT_SECONDS=20

# Fallback speed (mph) used only when live routing is unavailable
FALLBACK_SPEED_MPH=55

# SQLite location (defaults to backend/db.sqlite3)
# SQLITE_PATH=/data/db.sqlite3
